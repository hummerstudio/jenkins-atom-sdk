<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.jenkinschina</groupId>
  <artifactId>jenkins-atom-sdk-example</artifactId>
  <version>0.3.0</version>
  <packaging>jar</packaging>
  <name>Jenkins Atom SDK Example</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- build.sh 先打 sdk jar，再打本模块：离线机器上不必 mvn install -->
    <dependency>
      <groupId>com.jenkinschina</groupId>
      <artifactId>jenkins-atom-sdk</artifactId>
      <version>0.3.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../target/jenkins-atom-sdk-0.3.0.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
    </plugins>
  </build>
</project>
